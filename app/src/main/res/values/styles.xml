<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============ Typography ============
         Display face (Sora) is used with restraint: app wordmark, channel names, dialog titles.
         Everything else stays on the system face so the display face keeps its impact. -->

    <style name="TextAppearance.Iptv.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/sora_bold</item>
        <item name="android:fontFamily">@font/sora_bold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.Iptv.ChannelName" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/sora_semibold</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">15.5sp</item>
    </style>

    <style name="TextAppearance.Iptv.PlayerTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/sora_semibold</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">17sp</item>
    </style>

    <style name="TextAppearance.Iptv.DialogTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/sora_semibold</item>
        <item name="android:fontFamily">@font/sora_semibold</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="TextAppearance.Iptv.SectionLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="TextAppearance.Iptv.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/on_surface_muted</item>
    </style>

    <style name="TextAppearance.Iptv.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/on_surface_faint</item>
    </style>

    <!-- Monospace "LED counter" style used only for the channel-number chip: the app's one
         signature detail, so it stays exclusive to that element. -->
    <style name="TextAppearance.Iptv.ChannelNumber" parent="">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- ============ Shapes ============ -->

    <style name="ShapeAppearance.Iptv.Card" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Iptv.Chip" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ShapeAppearance.Iptv.Pill" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ============ Buttons ============ -->

    <style name="Widget.Iptv.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/surface_variant</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="iconTint">@color/accent</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Iptv.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/background</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Iptv.ToggleButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/stroke_hairline</item>
        <item name="android:textColor">@color/on_surface_muted</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
